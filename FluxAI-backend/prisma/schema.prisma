// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & ORGANIZATIONS
// ============================================

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String?
  firstName       String
  lastName        String
  authProvider    String?
  authProviderId  String?
  memberships     OrganizationMember[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([email])
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  logoUrl     String?
  website     String?
  plan        Plan                 @default(FREE)
  members     OrganizationMember[]
  assessments Assessment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(RECRUITER)
  joinedAt       DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

enum MemberRole {
  OWNER
  ADMIN
  RECRUITER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

// ============================================
// ASSESSMENTS
// ============================================

model Assessment {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String?
  title          String
  status         AssessmentStatus    @default(DRAFT)
  rounds         AssessmentRound[]
  attempts       AssessmentAttempt[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([status])
}

model AssessmentRound {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  roundType    RoundType
  enabled      Boolean    @default(false)
  order        Int
  config       Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, roundType])
  @@index([assessmentId])
}

enum AssessmentStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum RoundType {
  MCQ
  DSA
  AI
}

// ============================================
// QUESTION BANK
// ============================================

model Question {
  id         String       @id @default(cuid())
  type       QuestionType
  title      String
  difficulty Difficulty
  topics     String[]
  metadata   Json?
  mcqDetails MCQDetails?
  dsaDetails DSADetails?
  createdAt  DateTime     @default(now())

  @@index([type])
  @@index([difficulty])
}

model MCQDetails {
  questionId     String   @id
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  options        String[]
  correctOptions Int[]
  isMultiCorrect Boolean  @default(false)
}

model DSADetails {
  questionId         String   @id
  question           Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  prompt             String
  constraints        String?
  starterCode        Json
  languagesSupported String[]
}

enum QuestionType {
  MCQ
  DSA
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ============================================
// CANDIDATES & ATTEMPTS
// ============================================

model Candidate {
  id        String              @id @default(cuid())
  email     String              @unique
  firstName String?
  lastName  String?
  attempts  AssessmentAttempt[]
  createdAt DateTime            @default(now())

  @@index([email])
}

model AssessmentAttempt {
  id           String            @id @default(cuid())
  assessmentId String
  assessment   Assessment        @relation(fields: [assessmentId], references: [id])
  candidateId  String
  candidate    Candidate         @relation(fields: [candidateId], references: [id])
  status       AttemptStatus     @default(NOT_STARTED)
  startedAt    DateTime?
  submittedAt  DateTime?
  rounds       RoundAttempt[]
  events       ProctoringEvent[]
  evaluations  Evaluation[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([assessmentId, candidateId])
  @@index([assessmentId])
  @@index([candidateId])
  @@index([status])
}

model RoundAttempt {
  id        String            @id @default(cuid())
  attemptId String
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  roundType RoundType
  status    RoundStatus       @default(NOT_STARTED)
  startedAt DateTime?
  endedAt   DateTime?
  answers   Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([attemptId, roundType])
  @@index([attemptId])
}

model ProctoringEvent {
  id        String              @id @default(cuid())
  attemptId String
  attempt   AssessmentAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  roundType RoundType?
  eventType ProctoringEventType
  severity  EventSeverity       @default(LOW)
  createdAt DateTime            @default(now())

  @@index([attemptId])
  @@index([eventType])
}

model Evaluation {
  id          String            @id @default(cuid())
  attemptId   String
  attempt     AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  roundType   RoundType
  score       Float
  maxScore    Float
  metadata    Json?
  evaluatedAt DateTime          @default(now())

  @@unique([attemptId, roundType])
  @@index([attemptId])
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  TIMED_OUT
  DISQUALIFIED
}

enum RoundStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ProctoringEventType {
  TAB_SWITCH
  FACE_NOT_DETECTED
  MULTIPLE_FACES
  MIC_MUTED
  FULLSCREEN_EXIT
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================
// FILE STORAGE
// ============================================

model FileAsset {
  id             String    @id @default(cuid())
  organizationId String?
  ownerType      OwnerType
  ownerId        String
  fileType       FileType
  storageKey     String    @unique
  mimeType       String
  size           Int
  createdAt      DateTime  @default(now())

  @@index([ownerType, ownerId])
  @@index([organizationId])
}

enum OwnerType {
  CANDIDATE
  USER
}

enum FileType {
  RESUME
  VIDEO
}

