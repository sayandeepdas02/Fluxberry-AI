# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or self-hosted)
DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/fluxberry

# Redis connection string (used for BullMQ job queues and session blacklist)
REDIS_URL=redis://default:<password>@localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign access JWTs (min 32 random chars)
JWT_ACCESS_SECRET=change_me_access_secret

# Secret used to sign refresh JWTs (different from access secret)
JWT_REFRESH_SECRET=change_me_refresh_secret

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# OpenAI API key — used for question generation, answer evaluation, matching
OPENAI_API_KEY=sk-...

# Deepgram API key — used for Speech-to-Text in AI interviews
DEEPGRAM_API_KEY=...

# ElevenLabs API key — used for Text-to-Speech in AI interview responses
ELEVENLABS_API_KEY=...

# ── File Storage (AWS S3) ─────────────────────────────────────────────────────
# IAM user with s3:PutObject / s3:GetObject on the bucket
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=fluxberry-uploads

# ── Email ─────────────────────────────────────────────────────────────────────
# Resend API key — used for transactional emails (offers, reminders, invitations)
RESEND_API_KEY=re_...

# ── Payments ─────────────────────────────────────────────────────────────────
# Stripe secret key — used for subscription billing
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret — verify events from Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# ── OAuth ─────────────────────────────────────────────────────────────────────
# Google OAuth credentials — used for Google sign-in
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Video Interviews (LiveKit) ────────────────────────────────────────────────
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...

# ── Code Execution (Judge0) ───────────────────────────────────────────────────
# Used to run DSA test cases — RapidAPI hosted or self-hosted Judge0
JUDGE0_API_KEY=...
JUDGE0_RAPID_API_HOST=judge0-ce.p.rapidapi.com

# ── Optional ──────────────────────────────────────────────────────────────────
# Ribbon AI — alternative voice interview provider (webhook-based)
RIBBON_API_KEY=
