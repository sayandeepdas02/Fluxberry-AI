{
  "name": "fluxberry-backend",
  "version": "1.0.0",
  "description": "Fluxberry AI - Technical Hiring Assessment Platform API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently --names \"api,worker\" --prefix-colors \"cyan,yellow\" \"tsx watch src/server.ts\" \"tsx watch src/jobs/worker.ts\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/jobs/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "tsx src/jobs/worker.ts",
    "worker:prod": "node dist/jobs/worker.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "seed": "tsx src/database/seed.ts",
    "seed:questions": "tsx src/scripts/seed-questions.ts",
    "test:judge0": "tsx src/scripts/test-judge0.ts",
    "test:judge0:flow": "tsx src/scripts/judge0-flow.test.ts",
    "test:judge0:verify": "tsx src/__tests__/judge0.integration.ts",
    "test:ribbon:flow": "tsx src/scripts/ribbon-api.flow.test.ts",
    "test:ribbon:webhook": "tsx src/__tests__/ribbon-webhook.integration.ts"
  },
  "keywords": [
    "hiring",
    "assessment",
    "api",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "@deepgram/sdk": "^4.11.3",
    "@types/compression": "^1.8.1",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node-cron": "^3.0.11",
    "@types/puppeteer": "^5.4.7",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.67.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "elevenlabs": "^1.59.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.4.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.15.0",
    "mammoth": "^1.12.0",
    "mongoose": "^9.1.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "openai": "^6.18.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.37.2",
    "redis": "^5.11.0",
    "resend": "^6.9.1",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^7.0.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "undici": "^7.22.0"
  }
}
